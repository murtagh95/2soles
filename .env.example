# Copiar a .env.local y completar con los datos de la app web de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK de Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Solo si la base de Firestore no se llama "(default)"
VITE_FIRESTORE_DATABASE_ID=
# App Check (opcional): clave de sitio de reCAPTCHA Enterprise. Vacía = App Check apagado
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Solo para pnpm dev con App Check: token de depuración registrado en Firebase → App Check → Administrar tokens
VITE_APPCHECK_DEBUG_TOKEN=
# Solo para pnpm test:prod: poné 1 cuando App Check esté exigido en Firestore
APP_CHECK_EXIGIDO=
